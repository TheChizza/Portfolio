---
const { title, description, href } = Astro.props;
---
<article>
  <h2>{href ? <a href={href}>{title}</a> : title}</h2>
  <p>{description}</p>
</article>

<style>
  article { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  h2 { font-size: 1.15rem; margin: 0 0 0.25rem; }
  p { margin: 0; color: var(--muted); }
</style>
