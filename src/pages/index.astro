---
// Temporary holding page. The full site (Base layout, ProjectCard) lives in git history
// and comes back once the content is ready.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Chiu's website, coming soon." />
    <title>Chiu · Coming soon</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">chizza.net</p>
      <h1>Under construction</h1>
      <p>A new site is on its way. Check back soon.</p>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #fbfaf8; --text: #1c1b1a; --muted: #6b6762; --accent: #c2410c;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #141312; --text: #ece9e4; --muted: #a29d96; --accent: #fb923c; }
  }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--text); padding: 1rem; box-sizing: border-box; }
  main { text-align: center; max-width: 32rem; }
  .eyebrow { color: var(--accent); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.85rem; margin: 0 0 0.75rem; }
  h1 { font-size: clamp(2.2rem, 7vw, 3.5rem); line-height: 1.1; margin: 0 0 1rem; }
  p { color: var(--muted); font-size: 1.1rem; margin: 0; }
</style>
